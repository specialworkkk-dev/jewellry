# Application
MONGODB_URI=
# Conservative defaults for serverless. Increase only after Atlas monitoring.
MONGODB_MAX_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=15000
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.example
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# Optional distributed rate limiting. Without these, the app safely falls back
# to its existing per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_DEV_URL=

# Read-only provider monitoring
CLOUDFLARE_API_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Realtime customer and owner updates (server-side secret; never use NEXT_PUBLIC_)
ABLY_API_KEY=
ABLY_CONNECTION_LIMIT=200
ABLY_MONTHLY_MESSAGE_LIMIT=6000000

# Shop-specific Web Push (generate with: npm run generate:vapid)
# The public key is safe for browsers; never expose the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example

# Scheduled monitoring and alert thresholds
CRON_SECRET=
INFRA_MONTHLY_BUDGET_INR=500
USD_TO_INR_RATE=88
MONGODB_STORAGE_LIMIT_MB=512
R2_FREE_STORAGE_GB=10
R2_FREE_CLASS_A_OPERATIONS=1000000
R2_FREE_CLASS_B_OPERATIONS=10000000
