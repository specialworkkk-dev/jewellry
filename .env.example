# Application
MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.example
NEXT_PUBLIC_BASE_URL=https://your-domain.example

# Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_DEV_URL=

# Read-only provider monitoring
CLOUDFLARE_API_TOKEN=
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Realtime customer and owner updates (server-side secret; never use NEXT_PUBLIC_)
ABLY_API_KEY=

# Shop-specific Web Push (generate with: npm run generate:vapid)
# The public key is safe for browsers; never expose the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example

# Scheduled monitoring and alert thresholds
CRON_SECRET=
INFRA_MONTHLY_BUDGET_INR=500
USD_TO_INR_RATE=88
MONGODB_STORAGE_LIMIT_MB=512
R2_FREE_STORAGE_GB=10
R2_FREE_CLASS_A_OPERATIONS=1000000
R2_FREE_CLASS_B_OPERATIONS=10000000
